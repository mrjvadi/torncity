    "@vitejs/plugin-react": "4.7.0",
    "eslint": "9.31.0",
    "eslint-plugin-react-hooks": "5.2.0",
    "globals": "16.3.0",
    "typescript": "5.8.3",
    "typescript-eslint": "8.37.0",
    "vite": "7.0.5"
  },
  "overrides": {
    "esbuild": "0.25.6",
