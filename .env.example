# ---- Local Telegram Bot API server (ADR 0003) ----
# Obtain from https://my.telegram.org  — these are secrets, never commit real values.
TELEGRAM_API_ID=replace-me
TELEGRAM_API_HASH=replace-me

# Where the gateway sends Bot API requests.
# Cloud default: https://api.telegram.org
# Local server:  http://telegram-bot-api:8081
TELEGRAM_API_BASE_URL=http://telegram-bot-api:8081

# ---- Bot tokens ----
# telegram_bots.token_secret_ref holds the NAME of one of these variables,
# never the token itself (ADR 0002).
BOT01_TOKEN=replace-me
BOT02_TOKEN=replace-me
BOT03_TOKEN=replace-me

# ---- Infrastructure ----
# These hostnames are the unique network aliases declared in docker-compose.yml,
# not the bare service names. A bare "postgres" can resolve to another project's
# container when a service is attached to more than one network.
DATABASE_URL=postgres://torn:torn@tc-postgres:5432/torn?sslmode=disable
REDIS_URL=redis://tc-redis:6379/0
NATS_URL=nats://tc-nats:4222

# ---- Runtime ----
# Must be UNIQUE per running gateway instance. It is the fencing token on the
# redis bot lease: two instances sharing this value can renew and release each
# other's leases, and both will then poll the same bot. Telegram does not split
# updates between two pollers — each steals half the conversation. When scaling
# out, derive this from the hostname or a per-process uuid, never a fixed value.
GATEWAY_INSTANCE_ID=gateway-01
LOG_LEVEL=info

# Where player-visible text is read from. Optional, shown at its default.
# No message is compiled into a binary: every string on every screen comes
# from the *.yml files in this directory, one file per language. This path is
# an environment variable rather than a config.yml setting for the same reason
# DATABASE_URL is — something has to say where the content lives before any
# content has been read.
TORN_LOCALES_DIR=configs/locales

# ---- Outbox publisher (cmd/worker) ----
# Both are optional and shown at their defaults. The poll interval is the floor
# on how long a committed event waits before it reaches NATS; the batch size
# bounds how many rows one claim takes, and therefore how many events a worker
# that dies mid-batch republishes.
OUTBOX_POLL_INTERVAL=250ms
OUTBOX_BATCH_SIZE=100

# ---- Integration tests (make test-integration) ----
# Unset by default: every integration test skips unless its service is
# configured here, so `go test ./...` needs nothing running. These point at
# throwaway containers, never at a real environment.
# INTEGRATION_DSN=postgres://torn:torn@127.0.0.1:55432/torn?sslmode=disable
# INTEGRATION_REDIS_URL=redis://127.0.0.1:56379/0
# INTEGRATION_NATS_URL=nats://127.0.0.1:54222
